# Minimal test host for arrowlane-cpp: Wolfi (glibc, apk, supply chain
# oriented, newer GCC than Debian bookworm). The source is mounted read-only at
# run time, so the image only carries the toolchain.
FROM cgr.dev/chainguard/wolfi-base:latest

USER root
RUN apk add --no-cache \
        build-base \
        gcc \
        cmake \
        ninja \
        binutils \
        python-3.15 \
        py3.15-pip \
        util-linux \
        curl \
        ca-certificates

# Python 3.15 matches the host venv. The arrowlane reference package uses PEP
# 758 syntax (unparenthesised except tuples), which needs Python 3.14 or newer.
ENV PYTHON=python3.15
RUN $PYTHON -m pip install --no-cache-dir --break-system-packages \
        pyarrow==26.0.0 \
        orjson==3.13.0

COPY tools/run-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

WORKDIR /src
ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
