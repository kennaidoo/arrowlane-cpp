# Test host for arrowlane-cpp. Builds nothing at image time; the source is
# mounted read-only at run time so the image stays small.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        curl \
        ca-certificates \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages pyarrow==21.0.0

COPY tools/run-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

WORKDIR /src
ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
